# Environment Variables — Marketing Ops Center
# Copy to .env and fill in values

# Database
DB_PATH=./data/ops_dashboard.db

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encryption keys for sensitive data (AES-256-GCM)
API_CREDENTIALS_KEY=
ARTIST_BANK_KEY=

# Server
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Telegram Bot (Phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_VIDEOGRAPHER_CHAT_ID=
TELEGRAM_SMM_CHAT_ID=
WEBSITE_URL=http://localhost:3000

# Google Calendar (Phase 5)
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=

# Instagram Graph API (Phase 8)
# YouTube Data API (Phase 8)

# OpenClaw
# Hook endpoint OpenClaw is listening on for trigger requests (POST /hooks/agent).
# Local default assumes OpenClaw is running on the same machine. For a remote
# OpenClaw instance reachable only via Tailscale, use its Tailscale Serve URL,
# e.g. https://<machine>.<tailnet>.ts.net/hooks/agent — this requires the
# Hyphening server to also be joined to that same Tailscale network.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/hooks/agent
# Bearer token OpenClaw validates against its hooks.token config (NOT its
# gateway.auth.token, which is for the Control UI/WebSocket — different value).
OPENCLAW_HOOK_TOKEN=
# Shared secret used to verify HMAC-SHA256 signatures on inbound webhooks from
# OpenClaw at /api/openclaw/webhook. Must match the value OpenClaw signs with.
OPENCLAW_HMAC_SECRET=
#
# Base URL of the abort route exposed by OpenClaw's hyphening-abort plugin.
# The run id and '/abort' are appended, so this is the same base as
# OPENCLAW_GATEWAY_URL: e.g. https://<machine>.<tailnet>.ts.net/hooks/agent
# produces https://<machine>.<tailnet>.ts.net/hooks/agent/<runId>/abort.
# Put {runId} in the value to place the id somewhere else in the path instead.
#
# Leave BLANK if the plugin is not installed. Cancelling then only frees the
# queue slot here — the run continues inside OpenClaw and keeps spending — and
# the dashboard says so. Setting this turns Cancel into a real abort and the
# wording changes automatically.
OPENCLAW_ABORT_URL=
#
# OpenClaw agent that serves SEO runs, which is what decides the model:
# OpenClaw resolves it from agent.defaults.model.primary on the serving agent,
# and SKILL.md cannot override it. 'main' runs deepseek-v4-flash; 'seo' runs
# nemotron-3-ultra:free with a fallback chain ending at deepseek.
#
# This is the GLOBAL default. Per-skill routing lives in
# agent_run_config.agent_id and takes precedence — see
# scripts/set_agent_routing.js. Leave blank to use 'main'.
OPENCLAW_AGENT_ID=
