# Environment Variables — Marketing Ops Center
# Copy to .env and fill in values

# Database
DB_PATH=./data/ops_dashboard.db

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encryption keys for sensitive data (AES-256-GCM)
API_CREDENTIALS_KEY=
ARTIST_BANK_KEY=

# Server
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Internal-tool host split (leave ADMIN_HOST unset in dev)
# ADMIN_HOST=ops.hypheningmedia.com
# PUBLIC_HOST=hypheningmedia.com

# Website lead emails (src/services/mailer.js) — Google Workspace SMTP.
# SMTP_PASS is a 16-character Google App Password for SMTP_USER, not the account password.
# Leads are always saved to the DB; if these are blank the email is just skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hyphening Media Website <noreply@hypheningmedia.com>"
LEAD_NOTIFY_TO=deepanjan@hypheningmedia.com
# Optional: separate HMAC secret for the form timing token (falls back to JWT_ACCESS_SECRET)
LEAD_FORM_SECRET=

# Telegram Bot (Phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_VIDEOGRAPHER_CHAT_ID=
TELEGRAM_SMM_CHAT_ID=
WEBSITE_URL=http://localhost:3000

# Google Calendar (Phase 5)
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=

# Instagram Graph API (Phase 8)
# YouTube Data API (Phase 8)

# Mac connector push channel (src/services/macConnector.js)
# Shared token the Mac-side scripts/mac_connector.mjs presents on connect.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be the same value in the Ops Center's .env and the Mac's .env.
MAC_CONNECTOR_SECRET=

# Signed webhook (/api/webhooks/webhook)
# Shared secret the local workers sign with (scripts/lib/hook.mjs). Must be the
# same value here and in the Mac's .env. OPENCLAW_HMAC_SECRET is still read as
# a fallback by older environments.
HYPHENING_HMAC_SECRET=

# DataForSEO (src/services/keywordPlan.js, scripts/lib/dataforseo.mjs)
# Monthly keyword check and outreach. API login from app.dataforseo.com → API Access.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google account clients invite as a Manager on their Business Profile
# (shown in the onboarding Google access step).
GBP_AGENCY_EMAIL=
